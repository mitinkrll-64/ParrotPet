<Application x:Class="ParrotPet.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:ParrotPet.Views"
             xmlns:models="clr-namespace:ParrotPet.Models"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <views:HexBrushConverter x:Key="HexBrush"/>

        <!-- Элемент списка скинов: мини-иконка (тело + голова) и название -->
        <DataTemplate x:Key="SkinItemTemplate" DataType="{x:Type models:PetSkin}">
            <StackPanel Orientation="Horizontal">
                <Grid Width="22" Height="18" Margin="0,0,8,0">
                    <Ellipse Width="16" Height="14" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                             Fill="{Binding ColorBody, Converter={StaticResource HexBrush}}"/>
                    <Ellipse Width="11" Height="11" HorizontalAlignment="Right" VerticalAlignment="Top"
                             Fill="{Binding ColorHead, Converter={StaticResource HexBrush}}"/>
                </Grid>
                <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"/>
            </StackPanel>
        </DataTemplate>
    </Application.Resources>
</Application>