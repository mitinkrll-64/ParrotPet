<Window x:Class="ParrotPet.Views.DebugWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ParrotPet — Debug"
        Width="420" Height="640"
        MinWidth="380" MinHeight="600"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown">

    <!-- DataContext — DebugViewModel -->
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0">
            <!-- а) Управление анимациями -->
            <TabItem Header="Анимации">
                <StackPanel Margin="10">
                    <WrapPanel>
                        <Button Content="Play Idle" Command="{Binding PlayIdle}" Width="105" Height="28" Margin="3"/>
                        <Button Content="Play Walk ◀" Command="{Binding PlayWalkLeft}" Width="105" Height="28" Margin="3"/>
                        <Button Content="Play Walk ▶" Command="{Binding PlayWalkRight}" Width="105" Height="28" Margin="3"/>
                        <Button Content="Play Fly" Command="{Binding PlayFly}" Width="105" Height="28" Margin="3"/>
                        <Button Content="Fly → верх окна" Command="{Binding PlayFlyTop}" Width="105" Height="28" Margin="3"/>
                        <Button Content="Fly → бок окна" Command="{Binding PlayCling}" Width="105" Height="28" Margin="3"/>
                        <Button Content="Play Fall" Command="{Binding PlayFall}" Width="105" Height="28" Margin="3"/>
                        <Button Content="Play Eat" Command="{Binding PlayEat}" Width="105" Height="28" Margin="3"/>
                        <Button Content="Play Preen" Command="{Binding PlayPreen}" Width="105" Height="28" Margin="3"/>
                        <Button Content="Play Heart" Command="{Binding PlayHeart}" Width="105" Height="28" Margin="3"/>
                    </WrapPanel>
                    <TextBlock Text="Вид" FontWeight="SemiBold" Margin="3,12,0,2"/>
                    <WrapPanel>
                        <Button Content="Повернуться" Command="{Binding TurnAround}" Width="105" Height="28" Margin="3"/>
                        <Button Content="Смотреть на пользователя" Command="{Binding FaceUser}" Width="160" Height="28" Margin="3"/>
                    </WrapPanel>
                    <CheckBox Content="Всегда спереди (проверка всех анимаций)" IsChecked="{Binding ForceFront}" Margin="3,4,0,0"/>

                    <TextBlock Text="Действия в покое" FontWeight="SemiBold" Margin="3,12,0,2"/>
                    <ItemsControl ItemsSource="{Binding IdleActions}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Title}" Command="{Binding Command}" Width="105" Height="26" Margin="3"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <CheckBox Content="Автономное поведение (раз в 7–15 с)" IsChecked="{Binding AutoBehavior}" Margin="3,14,0,0"/>
                </StackPanel>
            </TabItem>

            <!-- б) Состояние питомца -->
            <TabItem Header="Состояние">
                <StackPanel Margin="10">
                    <TextBlock Text="Имя" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Случайное имя" Command="{Binding RandomName}" Padding="8,2" Margin="8,0,0,0"/>
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=LostFocus}" MaxLength="20" VerticalContentAlignment="Center"/>
                    </DockPanel>

                    <TextBlock Text="Скин (меняется сразу)" FontWeight="SemiBold" Margin="0,14,0,4"/>
                    <ComboBox ItemsSource="{Binding Skins}" SelectedValuePath="Id"
                              SelectedValue="{Binding ActiveSkinId, Mode=TwoWay}"
                              ItemTemplate="{StaticResource SkinItemTemplate}"/>

                    <TextBlock Text="Пол" FontWeight="SemiBold" Margin="0,14,0,4"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="Male (восковица синяя)" IsChecked="{Binding IsMale}" GroupName="Gender" Margin="0,0,16,0"/>
                        <RadioButton Content="Female (бежевая)" IsChecked="{Binding IsFemale}" GroupName="Gender"/>
                    </StackPanel>

                    <TextBlock Text="Сытость" FontWeight="SemiBold" Margin="0,14,0,4"/>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Width="40" TextAlignment="Right" VerticalAlignment="Center"
                                   Text="{Binding Value, ElementName=HungerSlider, StringFormat={}{0:0}}"/>
                        <Slider x:Name="HungerSlider" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"
                                Value="{Binding Hunger, Mode=TwoWay}"/>
                    </DockPanel>

                    <TextBlock Text="Возраст (дней)" FontWeight="SemiBold" Margin="0,14,0,4"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="−" Command="{Binding AgeMinus}" Width="30" Height="26"/>
                        <TextBox Text="{Binding AgeDays, UpdateSourceTrigger=LostFocus}" Width="70" Margin="6,0"
                                 TextAlignment="Center" VerticalContentAlignment="Center"/>
                        <Button Content="+" Command="{Binding AgePlus}" Width="30" Height="26"/>
                    </StackPanel>
                </StackPanel>
            </TabItem>

            <!-- в) Тестовые действия -->
            <TabItem Header="Тесты">
                <StackPanel Margin="10">
                    <Button Content="Бросить зерно рядом с попугаем" Command="{Binding DropSeed}" Height="30" Margin="0,0,0,8"/>
                    <Button Content="Телепортировать в центр экрана" Command="{Binding Teleport}" Height="30" Margin="0,0,0,8"/>
                    <Button Content="Сбросить сохранение (Reset Save)" Command="{Binding ResetSave}" Height="30"/>
                </StackPanel>
            </TabItem>
        </TabControl>

        <TextBlock Grid.Row="1" Text="{Binding CurrentState}" Margin="4,8,0,0" Opacity="0.8"/>
    </Grid>
</Window>