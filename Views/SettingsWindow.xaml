<Window x:Class="ParrotPet.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки ParrotPet"
        Width="400" SizeToContent="Height"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen">

    <!-- DataContext — черновик настроек (SettingsModel); применяется кнопками -->
    <StackPanel Margin="20">
        <TextBlock Text="Имя питомца" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <TextBox x:Name="NameBox" Margin="0,0,0,18"/>

        <TextBlock Text="Скин" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <ComboBox x:Name="SkinCombo" Margin="0,0,0,18"
                  ItemTemplate="{StaticResource SkinItemTemplate}"
                  SelectedValuePath="Id"/>

        <TextBlock Text="Монитор" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <ComboBox x:Name="ScreenCombo"
                  DisplayMemberPath="DisplayName"
                  SelectedValuePath="Id"
                  SelectedValue="{Binding SelectedScreen, Mode=TwoWay}"/>

        <TextBlock Text="Размер" FontWeight="SemiBold" Margin="0,18,0,6"/>
        <DockPanel>
            <TextBlock DockPanel.Dock="Right" Width="56" TextAlignment="Right" VerticalAlignment="Center"
                       Text="{Binding Value, ElementName=ScaleSlider, StringFormat={}{0:P0}}"/>
            <Slider x:Name="ScaleSlider" Minimum="0.5" Maximum="2" TickFrequency="0.1"
                    IsSnapToTickEnabled="True" TickPlacement="BottomRight"
                    Value="{Binding Scale, Mode=TwoWay}"/>
        </DockPanel>

        <TextBlock Text="Скорость поведения" FontWeight="SemiBold" Margin="0,18,0,6"/>
        <DockPanel>
            <TextBlock DockPanel.Dock="Right" Width="56" TextAlignment="Right" VerticalAlignment="Center"
                       Text="{Binding Value, ElementName=SpeedSlider, StringFormat=×{0:0.0}}"/>
            <Slider x:Name="SpeedSlider" Minimum="0.5" Maximum="2" TickFrequency="0.1"
                    IsSnapToTickEnabled="True" TickPlacement="BottomRight"
                    Value="{Binding BehaviorSpeed, Mode=TwoWay}"/>
        </DockPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button Content="Применить" Width="100" Height="28" Margin="0,0,8,0" Click="Apply_Click"/>
            <Button Content="Сохранить" Width="100" Height="28" IsDefault="True" Click="Save_Click"/>
        </StackPanel>
    </StackPanel>
</Window>