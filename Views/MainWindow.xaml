<Window x:Class="ParrotPet.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ParrotPet"
        Width="96" Height="96"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        ClipToBounds="False"
        KeyDown="Window_KeyDown"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseMove="Window_MouseMove"
        MouseLeftButtonUp="Window_MouseLeftButtonUp">

    <!-- Масштаб из настроек: окно квадратное (96 * Scale), содержимое растягивается ScaleTransform -->
    <Grid ClipToBounds="False">
        <Grid.LayoutTransform>
            <ScaleTransform x:Name="ContentScale" ScaleX="1" ScaleY="1"/>
        </Grid.LayoutTransform>

        <!-- Холст 96x96: логический хитбокс 64x64 лежит в центре, по краям запас для клюва, хвоста и поворотов -->
        <Canvas Width="96" Height="96" ClipToBounds="False">

            <!-- Поза всего тела; точка вращения — низ хитбокса по центру (0.5, 80/96) -->
            <Canvas Width="96" Height="96" ClipToBounds="False" RenderTransformOrigin="0.5,0.8333">
                <Canvas.RenderTransform>
                    <TransformGroup>
                        <!-- Порядок важен: сначала сжатие/растяжение, затем наклон, затем разворот -->
                        <ScaleTransform x:Name="PoseScale" ScaleX="1" ScaleY="1"/>
                        <RotateTransform x:Name="PoseRotate" Angle="0"/>
                        <!-- ScaleX = 1 вправо, -1 влево -->
                        <ScaleTransform x:Name="ParrotFlip" ScaleX="1"/>
                    </TransformGroup>
                </Canvas.RenderTransform>

                <!-- Волнистый попугайчик в системе координат хитбокса 64x64. Анимации привязаны к контейнерам
                     BodyContainer / HeadContainer / WingContainer / TailContainer (их RenderTransform),
                     а цвета частей берутся из ресурсов Skin.* (SkinService) — анимации про скин ничего не знают -->
                <Canvas Canvas.Left="16" Canvas.Top="16" Width="64" Height="64" ClipToBounds="False">

                    <!-- Длинный ступенчатый хвост -->
                    <Canvas x:Name="TailContainer">
                        <Canvas.RenderTransform>
                            <RotateTransform x:Name="TailRot" CenterX="24" CenterY="44"/>
                        </Canvas.RenderTransform>
                        <Polygon Points="21,41 29,45 12,67 6,62" Fill="{DynamicResource Skin.Tail1}"/>
                        <Polygon Points="23,42 30,46 19,64 13,59" Fill="{DynamicResource Skin.Tail2}"/>
                        <Polygon Points="25,44 31,47 25,58 21,55" Fill="{DynamicResource Skin.Tail3}"/>
                    </Canvas>

                    <!-- Лапки -->
                    <Rectangle Canvas.Left="28" Canvas.Top="55" Width="2.4" Height="7" Fill="{DynamicResource Skin.Feet}"/>
                    <Rectangle Canvas.Left="37" Canvas.Top="55" Width="2.4" Height="7" Fill="{DynamicResource Skin.Feet}"/>
                    <Ellipse Canvas.Left="25.5" Canvas.Top="60" Width="8" Height="3" Fill="{DynamicResource Skin.Feet}"/>
                    <Ellipse Canvas.Left="34.5" Canvas.Top="60" Width="8" Height="3" Fill="{DynamicResource Skin.Feet}"/>

                    <!-- Тело (дыхание масштабирует грудку) -->
                    <Canvas x:Name="BodyContainer">
                        <Canvas.RenderTransform>
                            <ScaleTransform x:Name="BreathScale" CenterX="29" CenterY="59"/>
                        </Canvas.RenderTransform>
                        <Ellipse Canvas.Left="11" Canvas.Top="25" Width="38" Height="34" Fill="{DynamicResource Skin.BodyGradient}"/>
                    </Canvas>

                    <!-- Крыло с волнистыми тёмными полосками -->
                    <Canvas x:Name="WingContainer">
                        <Canvas.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="WingScale" CenterX="23" CenterY="34"/>
                                <RotateTransform x:Name="WingRot" CenterX="23" CenterY="34"/>
                            </TransformGroup>
                        </Canvas.RenderTransform>
                        <Ellipse Canvas.Left="13" Canvas.Top="33" Width="20" Height="22" Fill="{DynamicResource Skin.Wing}"/>
                        <Path Data="M15,39 Q18,36 21,39 T27,39 T31,39" Stroke="{DynamicResource Skin.WingStripes}" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        <Path Data="M14.5,44 Q17.5,41 20.5,44 T26.5,44 T31,44" Stroke="{DynamicResource Skin.WingStripes}" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        <Path Data="M15.5,49 Q18.5,46 21.5,49 T27.5,49 T30,49" Stroke="{DynamicResource Skin.WingStripes}" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Canvas>

                    <!-- Голова: лимонно-жёлтая, полоски на затылке, щёчные пятна, восковица, изогнутый клюв -->
                    <Canvas x:Name="HeadContainer">
                        <Canvas.RenderTransform>
                            <RotateTransform x:Name="HeadRot" CenterX="36" CenterY="32"/>
                        </Canvas.RenderTransform>

                        <Ellipse Canvas.Left="22" Canvas.Top="5" Width="30" Height="30" Fill="{DynamicResource Skin.Head}"/>

                        <!-- Волнистые полоски на затылке -->
                        <Path Data="M24,11 Q26.5,8.5 29,11 T34,11" Stroke="{DynamicResource Skin.Stripes}" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        <Path Data="M23,16 Q25.5,13.5 28,16 T33,16" Stroke="{DynamicResource Skin.Stripes}" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        <Path Data="M23.5,21 Q26,18.5 28.5,21 T33.5,21" Stroke="{DynamicResource Skin.Stripes}" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        <Path Data="M25,26 Q27,24 29,26" Stroke="{DynamicResource Skin.Stripes}" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>

                        <!-- Щёчное фиолетовое пятно с синим -->
                        <Ellipse Canvas.Left="35" Canvas.Top="25" Width="7.5" Height="5" Fill="{DynamicResource Skin.Cheek}"/>
                        <Ellipse Canvas.Left="39" Canvas.Top="27" Width="3.5" Height="2.8" Fill="{DynamicResource Skin.Cheek2}"/>

                        <!-- Три точки на горле -->
                        <Ellipse Canvas.Left="39.5" Canvas.Top="30.5" Width="2.2" Height="2.2" Fill="{DynamicResource Skin.Stripes}"/>
                        <Ellipse Canvas.Left="43" Canvas.Top="29.5" Width="2.2" Height="2.2" Fill="{DynamicResource Skin.Stripes}"/>
                        <Ellipse Canvas.Left="46.2" Canvas.Top="27.5" Width="2.2" Height="2.2" Fill="{DynamicResource Skin.Stripes}"/>

                        <!-- Изогнутый клюв и синяя восковица над ним -->
                        <Path Data="M48,21 C54,18 61,22 59.5,30 C58,27.5 54,26.5 50,27.5 Z" Fill="{DynamicResource Skin.Beak}"/>
                        <Ellipse x:Name="Cere" Canvas.Left="46.5" Canvas.Top="18.5" Width="8" Height="6.5" Fill="#2E86FF"/>
                        <Ellipse x:Name="Nostril" Canvas.Left="51" Canvas.Top="20.5" Width="1.6" Height="1.6" Fill="#1B4FB0"/>

                        <!-- Глаз (моргание масштабирует по Y) -->
                        <Canvas>
                            <Canvas.RenderTransform>
                                <ScaleTransform x:Name="EyeScale" CenterX="43" CenterY="19"/>
                            </Canvas.RenderTransform>
                            <Ellipse Canvas.Left="38" Canvas.Top="14" Width="10" Height="10" Fill="White" Stroke="#455A64" StrokeThickness="0.6"/>
                            <Ellipse Canvas.Left="41" Canvas.Top="16.5" Width="5.2" Height="5.2" Fill="#111111"/>
                            <Ellipse Canvas.Left="44" Canvas.Top="16.8" Width="1.8" Height="1.8" Fill="White"/>
                        </Canvas>
                    </Canvas>
                </Canvas>
            </Canvas>

            <!-- Сердечко над головой: не вращается и не разворачивается вместе с телом -->
            <Path x:Name="HeartPath" Canvas.Left="43" Canvas.Top="3" Opacity="0" Fill="#E53935"
                  Data="M0,3 C0,0 4,0 5,3 C6,0 10,0 10,3 C10,6 5,9 5,10 C5,9 0,6 0,3 Z"
                  RenderTransformOrigin="0.5,0.5">
                <Path.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="HeartScale" ScaleX="1" ScaleY="1"/>
                        <TranslateTransform x:Name="HeartMove" Y="0"/>
                    </TransformGroup>
                </Path.RenderTransform>
            </Path>
        </Canvas>
    </Grid>
</Window>