<Window x:Class="ParrotPet.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ParrotPet"
        Width="96" Height="96"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        ClipToBounds="False"
        KeyDown="Window_KeyDown"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseMove="Window_MouseMove"
        MouseLeftButtonUp="Window_MouseLeftButtonUp">

    <Window.ContextMenu>
        <ContextMenu x:Name="PetMenu" Opened="PetMenu_Opened">
            <!-- Карточка питомца: заполняется при открытии -->
            <StackPanel Margin="12,8,12,6" MinWidth="190">
                <TextBlock x:Name="MenuName" FontSize="16" FontWeight="Bold"/>
                <TextBlock x:Name="MenuGender" Margin="0,2,0,0"/>
                <TextBlock x:Name="MenuAge" Margin="0,2,0,0"/>
                <TextBlock Text="Сытость" Margin="0,8,0,3"/>
                <ProgressBar x:Name="MenuHunger" Minimum="0" Maximum="100" Height="10" Foreground="#43A047"/>
                <TextBlock x:Name="MenuHungerText" HorizontalAlignment="Right" FontSize="11" Opacity="0.7"/>
            </StackPanel>
            <Separator/>
            <MenuItem Header="Покормить" Click="MenuFeed_Click"/>
            <MenuItem Header="Настройки..." Click="MenuSettings_Click"/>
        </ContextMenu>
    </Window.ContextMenu>
    <!-- Масштаб из настроек: окно квадратное (96 * Scale), содержимое растягивается ScaleTransform -->
    <Grid ClipToBounds="False">
        <Grid.LayoutTransform>
            <ScaleTransform x:Name="ContentScale" ScaleX="1" ScaleY="1"/>
        </Grid.LayoutTransform>

        <!-- Холст 96x96: логический хитбокс 64x64 лежит в центре, по краям запас для клюва, хвоста и поворотов -->
        <Canvas Width="96" Height="96" ClipToBounds="False">

            <!-- Поза всего тела; точка вращения — низ хитбокса по центру (0.5, 80/96) -->
            <Canvas Width="96" Height="96" ClipToBounds="False" RenderTransformOrigin="0.5,0.8333">
                <Canvas.RenderTransform>
                    <TransformGroup>
                        <!-- Порядок важен: сначала сдвиг (подскок, подтягивание), затем сжатие/растяжение, наклон и разворот -->
                        <TranslateTransform x:Name="PoseOffset" X="0" Y="0"/>
                        <ScaleTransform x:Name="PoseScale" ScaleX="1" ScaleY="1"/>
                        <RotateTransform x:Name="PoseRotate" Angle="0"/>
                        <!-- ScaleX = 1 вправо, -1 влево -->
                        <ScaleTransform x:Name="ParrotFlip" ScaleX="1"/>
                    </TransformGroup>
                </Canvas.RenderTransform>

                <!-- Пиксель-арт попугайчик в системе координат хитбокса 64x64. Каждый контейнер
                     (Tail/Body/Wing/Head) — отдельный слой-картинка 96x96, который анимации вращают
                     и масштабируют через RenderTransform. Картинки слоёв берутся из ресурсов Skin.*Image
                     (SkinService + PixelSpriteBuilder), поэтому анимации про скин ничего не знают. -->
                <Canvas x:Name="SideRig" Canvas.Left="16" Canvas.Top="16" Width="64" Height="64" ClipToBounds="False"
                        SnapsToDevicePixels="True" RenderOptions.BitmapScalingMode="NearestNeighbor">

                    <!-- Хвост -->
                    <Canvas x:Name="TailContainer">
                        <Canvas.RenderTransform>
                            <RotateTransform x:Name="TailRot" CenterX="27" CenterY="51"/>
                        </Canvas.RenderTransform>
                        <Image Source="{DynamicResource Skin.TailImage}" Canvas.Left="-16" Canvas.Top="-16" Width="96" Height="96" Stretch="Fill"/>
                    </Canvas>

                    <!-- Дальняя лапка: за телом, чтобы пух живота прикрывал бедро -->
                    <Canvas x:Name="FarFootContainer">
                        <Canvas.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="FarFootTuckScale" CenterX="41.5" CenterY="55.5"/>
                                <RotateTransform x:Name="FarFootRot" CenterX="41.5" CenterY="55.5"/>
                            </TransformGroup>
                        </Canvas.RenderTransform>
                        <Image Source="{DynamicResource Skin.FarFootImage}" Canvas.Left="-16" Canvas.Top="-16" Width="96" Height="96" Stretch="Fill"/>
                    </Canvas>

                    <!-- Тело (дыхание масштабирует грудку от низа) -->
                    <Canvas x:Name="BodyContainer">
                        <Canvas.RenderTransform>
                            <ScaleTransform x:Name="BreathScale" CenterX="43" CenterY="56"/>
                        </Canvas.RenderTransform>
                        <Image Source="{DynamicResource Skin.BodyImage}" Canvas.Left="-16" Canvas.Top="-16" Width="96" Height="96" Stretch="Fill"/>
                    </Canvas>

                    <!-- Ближняя лапка: поворот вокруг бедра (потягивание, подъём) и «подбирание» в перья -->
                    <Canvas x:Name="FootContainer">
                        <Canvas.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="FootTuckScale" CenterX="35.5" CenterY="55.5"/>
                                <RotateTransform x:Name="FootRot" CenterX="35.5" CenterY="55.5"/>
                            </TransformGroup>
                        </Canvas.RenderTransform>
                        <Image Source="{DynamicResource Skin.FootImage}" Canvas.Left="-16" Canvas.Top="-16" Width="96" Height="96" Stretch="Fill"/>
                    </Canvas>

                    <!-- Крыло: взмах — масштаб по Y и поворот вокруг плеча -->
                    <Canvas x:Name="WingContainer">
                        <Canvas.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="WingScale" CenterX="41" CenterY="34"/>
                                <RotateTransform x:Name="WingRot" CenterX="41" CenterY="34"/>
                            </TransformGroup>
                        </Canvas.RenderTransform>
                        <Image Source="{DynamicResource Skin.WingImage}" Canvas.Left="-16" Canvas.Top="-16" Width="96" Height="96" Stretch="Fill"/>
                    </Canvas>

                    <!-- Шея: перо между основанием шеи (48,41) и сдвинутой головой — при чистке голова не «отрывается» от туловища.
                         Длина считается в коде (MainWindow.xaml.cs), пока голова на месте — шея невидима -->

                    <Line x:Name="NeckFill" X1="48" Y1="41" X2="48" Y2="41" Opacity="0" StrokeThickness="11"
                          Stroke="{DynamicResource Skin.NeckBrush}" StrokeStartLineCap="Round" StrokeEndLineCap="Flat"
                          RenderOptions.EdgeMode="Aliased"/>

                    <!-- Голова вместе с глазом: поворот вокруг шеи -->
                    <Canvas x:Name="HeadContainer">
                        <Canvas.RenderTransform>
                            <TransformGroup>
                                <!-- Сначала поворот вокруг шеи, затем сдвиг (шея тянется или втягивается) -->
                                <RotateTransform x:Name="HeadRot" CenterX="48" CenterY="41"/>
                                <TranslateTransform x:Name="HeadMove" X="0" Y="0"/>
                            </TransformGroup>
                        </Canvas.RenderTransform>
                        <Image Source="{DynamicResource Skin.HeadImage}" Canvas.Left="-16" Canvas.Top="-16" Width="96" Height="96" Stretch="Fill"/>

                        <!-- Нижняя половина клюва: шарнир у основания, открывается при зевке, пении и скрипе клювом -->
                        <Canvas>
                            <Canvas.RenderTransform>
                                <RotateTransform x:Name="BeakRot" CenterX="58.5" CenterY="34"/>
                            </Canvas.RenderTransform>
                            <Image Source="{DynamicResource Skin.BeakImage}" Canvas.Left="-16" Canvas.Top="-16" Width="96" Height="96" Stretch="Fill"/>
                        </Canvas>

                        <!-- Глаз: крупный (3x4), два блика; моргание и «сонный» прищур масштабируют по Y -->
                        <Canvas>
                            <Canvas.RenderTransform>
                                <ScaleTransform x:Name="EyeScale" CenterX="52" CenterY="31.5"/>
                            </Canvas.RenderTransform>
                            <!-- Глаз как на референсе: чёрный овал 2x3, один блик сзади-сверху -->
                            <Rectangle Canvas.Left="51" Canvas.Top="30" Width="2" Height="3" Fill="#15151A"/>
                            <Rectangle Canvas.Left="51" Canvas.Top="30" Width="1" Height="1" Fill="White"/>
                        </Canvas>
                    </Canvas>
                </Canvas>

                <!-- Фронтальный вид: птица сидит и смотрит на пользователя. Тот же принцип: каждая часть —
                     отдельный слой с RenderTransform, цвета из ресурсов Skin.Front*Image. Анимации (одна и та же
                     AnimationPose) переводятся в трансформации этих слоёв в MainWindow.xaml.cs -->
                <Canvas x:Name="FrontRig" Canvas.Left="16" Canvas.Top="16" Width="64" Height="64" ClipToBounds="False"
                        Visibility="Collapsed" SnapsToDevicePixels="True" RenderOptions.BitmapScalingMode="NearestNeighbor">

                    <Canvas x:Name="FTailContainer">
                        <Canvas.RenderTransform>
                            <RotateTransform x:Name="FTailRot" CenterX="32" CenterY="56"/>
                        </Canvas.RenderTransform>
                        <Image Source="{DynamicResource Skin.FrontTailImage}" Canvas.Left="-16" Canvas.Top="-16" Width="96" Height="96" Stretch="Fill"/>
                    </Canvas>

                    <!-- Лапки: подъём (шаг) и «подбирание» в перья -->
                    <Canvas x:Name="FFootLContainer">
                        <Canvas.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="FFootLScale" CenterX="28" CenterY="57"/>
                                <TranslateTransform x:Name="FFootLMove" X="0" Y="0"/>
                            </TransformGroup>
                        </Canvas.RenderTransform>
                        <Image Source="{DynamicResource Skin.FrontFootLImage}" Canvas.Left="-16" Canvas.Top="-16" Width="96" Height="96" Stretch="Fill"/>
                    </Canvas>
                    <Canvas x:Name="FFootRContainer">
                        <Canvas.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="FFootRScale" CenterX="36" CenterY="57"/>
                                <TranslateTransform x:Name="FFootRMove" X="0" Y="0"/>
                            </TransformGroup>
                        </Canvas.RenderTransform>
                        <Image Source="{DynamicResource Skin.FrontFootRImage}" Canvas.Left="-16" Canvas.Top="-16" Width="96" Height="96" Stretch="Fill"/>
                    </Canvas>

                    <Canvas x:Name="FBodyContainer">
                        <Canvas.RenderTransform>
                            <ScaleTransform x:Name="FBreathScale" CenterX="32" CenterY="58"/>
                        </Canvas.RenderTransform>
                        <Image Source="{DynamicResource Skin.FrontBodyImage}" Canvas.Left="-16" Canvas.Top="-16" Width="96" Height="96" Stretch="Fill"/>
                    </Canvas>

                    <!-- Крылья по бокам: поворот и масштаб вокруг плеча (наружу — «+» у левого, «−» у правого) -->
                    <Canvas x:Name="FWingLContainer">
                        <Canvas.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="FWingLScale" CenterX="21.5" CenterY="43"/>
                                <RotateTransform x:Name="FWingLRot" CenterX="21.5" CenterY="43"/>
                            </TransformGroup>
                        </Canvas.RenderTransform>
                        <Image Source="{DynamicResource Skin.FrontWingLImage}" Canvas.Left="-16" Canvas.Top="-16" Width="96" Height="96" Stretch="Fill"/>
                    </Canvas>
                    <Canvas x:Name="FWingRContainer">
                        <Canvas.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="FWingRScale" CenterX="42.5" CenterY="43"/>
                                <RotateTransform x:Name="FWingRRot" CenterX="42.5" CenterY="43"/>
                            </TransformGroup>
                        </Canvas.RenderTransform>
                        <Image Source="{DynamicResource Skin.FrontWingRImage}" Canvas.Left="-16" Canvas.Top="-16" Width="96" Height="96" Stretch="Fill"/>
                    </Canvas>

                    <!-- Шея спереди -->

                    <Line x:Name="FNeckFill" X1="32" Y1="41" X2="32" Y2="41" Opacity="0" StrokeThickness="14"
                          Stroke="{DynamicResource Skin.NeckBrush}" StrokeStartLineCap="Round" StrokeEndLineCap="Flat"
                          RenderOptions.EdgeMode="Aliased"/>

                    <!-- Голова: наклон вбок (крен), опускание/подъём, сжатие по высоте при поклоне -->
                    <Canvas x:Name="FHeadContainer">
                        <Canvas.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="FHeadScale" CenterX="32" CenterY="41"/>
                                <RotateTransform x:Name="FHeadRot" CenterX="32" CenterY="41"/>
                                <TranslateTransform x:Name="FHeadMove" X="0" Y="0"/>
                            </TransformGroup>
                        </Canvas.RenderTransform>
                        <Image Source="{DynamicResource Skin.FrontHeadImage}" Canvas.Left="-16" Canvas.Top="-16" Width="96" Height="96" Stretch="Fill"/>

                        <Canvas>
                            <Canvas.RenderTransform>
                                <TranslateTransform x:Name="FBeakMove" X="0" Y="0"/>
                            </Canvas.RenderTransform>
                            <Image Source="{DynamicResource Skin.FrontBeakImage}" Canvas.Left="-16" Canvas.Top="-16" Width="96" Height="96" Stretch="Fill"/>
                        </Canvas>

                        <!-- Два глаза: чёрные овалы 2x3 с бликом; моргание масштабирует по Y -->
                        <Canvas>
                            <Canvas.RenderTransform>
                                <ScaleTransform x:Name="FEyeLScale" CenterX="28" CenterY="31.5"/>
                            </Canvas.RenderTransform>
                            <Rectangle Canvas.Left="27" Canvas.Top="30" Width="2" Height="3" Fill="#15151A"/>
                            <Rectangle Canvas.Left="27" Canvas.Top="30" Width="1" Height="1" Fill="White"/>
                        </Canvas>
                        <Canvas>
                            <Canvas.RenderTransform>
                                <ScaleTransform x:Name="FEyeRScale" CenterX="37" CenterY="31.5"/>
                            </Canvas.RenderTransform>
                            <Rectangle Canvas.Left="36" Canvas.Top="30" Width="2" Height="3" Fill="#15151A"/>
                            <Rectangle Canvas.Left="36" Canvas.Top="30" Width="1" Height="1" Fill="White"/>
                        </Canvas>
                    </Canvas>
                </Canvas>
            </Canvas>
            <!-- Сердечко над головой: не вращается и не разворачивается вместе с телом -->
            <Path x:Name="HeartPath" Canvas.Left="43" Canvas.Top="3" Opacity="0" Fill="#E53935"
                  Data="M0,3 C0,0 4,0 5,3 C6,0 10,0 10,3 C10,6 5,9 5,10 C5,9 0,6 0,3 Z"
                  RenderTransformOrigin="0.5,0.5">
                <Path.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="HeartScale" ScaleX="1" ScaleY="1"/>
                        <TranslateTransform x:Name="HeartMove" Y="0"/>
                    </TransformGroup>
                </Path.RenderTransform>
            </Path>
        </Canvas>
    </Grid>
</Window>